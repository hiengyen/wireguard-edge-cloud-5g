# ==============================================================
# Environment example for Terraform, monitoring, edge runtime,
# benchmark suites, and PeerSight.
#
# Load with:
#   cp .env.example .env
#   set -a && . ./.env && set +a
#
# Replace placeholder values before production use. Do not commit
# real private keys, tokens, public IP allowlists, or passwords.
# ==============================================================

# ==============================================================
# Terraform / Cloud
# Consumed by Terraform as TF_VAR_* inputs in cloud/terraform/ec2.
# ==============================================================

TF_VAR_aws_region=ap-southeast-1
TF_VAR_project_name=vpn
TF_VAR_vpc_id=vpc-xxxxxxxx
TF_VAR_subnet_id=subnet-xxxxxxxx
TF_VAR_instance_type=t3.medium
TF_VAR_key_name=your-existing-ec2-keypair-name
TF_VAR_root_volume_size=20

# Restrict this to your admin IP/CIDR before deployment.
TF_VAR_admin_ssh_cidr='["203.0.113.10/32"]'

TF_VAR_wireguard_port=51820
TF_VAR_wireguard_network=10.8.0.0/24
TF_VAR_wireguard_client_cidr=10.8.0.2/32

TF_VAR_common_tags='{"Project":"WireGuard-VPN","ManagedBy":"Terraform","Environment":"production"}'
TF_VAR_grafana_admin_password=CHANGE_ME_BEFORE_DEPLOYMENT
TF_VAR_prometheus_version=v3.11.2
TF_VAR_grafana_version=13.0.1

# Cloud public IP is auto-detected by benchmark/config.sh from
# Terraform state when possible. Set manually when running outside
# that Terraform working tree or for direct-vs-VPN overhead tests.
CLOUD_PUBLIC_IP=

# ==============================================================
# Monitoring / Observability
# Used by cloud/monitoring/docker-compose.yml, hardening.sh,
# benchmark service tests, and Grafana Alloy on edge nodes.
# ==============================================================

GRAFANA_ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOYMENT
PROMETHEUS_VERSION=v3.11.2
GRAFANA_VERSION=13.0.1
LOKI_VERSION=3.7.1

# 127.0.0.1 = local-only on cloud, usually accessed via SSH tunnel.
# 10.8.0.1 = reachable over the WireGuard overlay.
MONITORING_BIND_ADDRESS=127.0.0.1
ALLOW_MONITORING_OVER_WIREGUARD=false

GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
NODE_EXPORTER_PORT=9100

PROMETHEUS_URL=http://10.8.0.1:9090
LOKI_URL=http://10.8.0.1:3100
GRAFANA_URL=http://10.8.0.1:3000
NODE_EXPORTER_CLOUD=http://10.8.0.1:9100
NODE_EXPORTER_EDGE=http://127.0.0.1:9100

ALLOY_CONFIG_SRC=edge/observability/alloy/config.alloy
ALLOY_CONFIG_DST=/etc/alloy/config.alloy
ALLOY_LOKI_URL=http://10.8.0.1:3100/loki/api/v1/push
ALLOY_HTTP_LISTEN_ADDR=0.0.0.0:12345
REMOVE_ALLOY_CONFIG=true

# Amazon Linux hardening helper can restart Docker after firewalld
# changes so Docker recreates its iptables chains.
RESTART_DOCKER_IF_ACTIVE=true

# ==============================================================
# Edge WireGuard Runtime
# Used by edge/vpn scripts and shared hardening.
# ==============================================================

WIREGUARD_PORT=51820
WIREGUARD_NETWORK=10.8.0.0/24
WIREGUARD_ALLOWED_IPS=10.8.0.0/24
WIREGUARD_INTERFACE=wg0
REMOVE_WG_KEYS=false

# Benchmark scripts use WG_* names internally.
WG_SERVER_IP=10.8.0.1
WG_CLIENT_IP=10.8.0.2
WG_INTERFACE=wg0
WG_PORT=51820

# ==============================================================
# Edge WWAN / 5G Runtime
# Used by edge/5g-wwan scripts and benchmark WWAN tests.
# ==============================================================

WWAN_APN=internet
WWAN_DEVICE_WAIT_TIMEOUT=45
WWAN_QMI_START_RETRIES=3
WWAN_QMI_START_RETRY_DELAY=5
WWAN_DHCP_RETRIES=3
WWAN_DHCP_RETRY_DELAY=5
WWAN_CONNECTIVITY_TARGET=8.8.8.8

# Leave empty to auto-detect the first ww* interface.
WWAN_INTERFACE=
QMI_DEVICE=

SSH_ADMIN_PORT=22
EDGE_EXTRA_TCP_PORTS='443 5201'

# ==============================================================
# Benchmark Common Settings
# Used by benchmark/config.sh and benchmark/run_all.sh.
# ==============================================================

REPORT_DIR=./reports
HTTP_TIMEOUT=10

PING_COUNT=20
PING_INTERVAL=0.2

IPERF3_SERVER=10.8.0.1
IPERF3_PORT=5201
IPERF3_DURATION=10
IPERF3_PARALLEL=4
SUSTAINED_DURATION=60

SSH_USER=ec2-user
SSH_KEY=~/.ssh/id_rsa
REMOTE_TMP=/tmp/benchmark_rx
LOCAL_TMP=/tmp/benchmark_tx

# ==============================================================
# Benchmark Thresholds
# Used by individual benchmark suites.
#
# MAX_LOSS_PCT and MAX_JITTER_MS are shared by latency and UDP
# tests. If unset, scripts use suite-specific defaults.
# ==============================================================

MAX_HANDSHAKE_AGE=180
MAX_RTT_MS=150
MAX_LOSS_PCT=5
MAX_JITTER_MS=30

MIN_RSRP=-110
MIN_RSRQ=-20

MIN_TCP_MBPS=5
MIN_UDP_MBPS=2
MIN_RSYNC_MBPS=2

MIN_SUSTAINED_MBPS=3
MAX_VARIANCE_PCT=40

CONCURRENCY=10
ITERATIONS=30
MAX_P95_MS=3000

MAX_RECONNECT_S=30
MAX_WG_RECOVERY_S=60
MAX_MONITORING_GAP_S=120

# ==============================================================
# PeerSight Cloud Deployment
# Used by peersight/docker-compose.yml and peersight/deploy-cloud.sh.
# ==============================================================

PEERSIGHT_DB_PASSWORD=CHANGE_ME_PEERSIGHT_DB_PASSWORD
PEERSIGHT_JWT_SECRET=CHANGE_ME_PEERSIGHT_JWT_SECRET
PEERSIGHT_API_PORT=4000
PEERSIGHT_APP_PORT=5173

# Broker auth token is generated from PeerSight after initial setup.
PEERSIGHT_BROKER_TOKEN=
PEERSIGHT_BROKER_ID=cloud-broker-1
PEERSIGHT_QUEUE_LEASE_SECONDS=60

PEERSIGHT_HOST_STALE_SECONDS=120
PEERSIGHT_HANDSHAKE_STALE_SECONDS=180
PEERSIGHT_QUEUE_BACKLOG_ALERT_THRESHOLD=1000

# ==============================================================
# PeerSight API / App Local Runtime
# Used when running peersight-api and peersight-app outside Docker.
# ==============================================================

DATABASE_URL=postgres://peersight:peersight@localhost:5432/peersight?sslmode=disable
JWT_SECRET=change-me-in-production
PORT=4000
ENV=development
ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:4000

# ==============================================================
# PeerSight Agent / Broker Runtime
# Used by peersight/install-agent.sh, deploy-edge.sh,
# peersight-agent, and peersight-broker.
# ==============================================================

PEERSIGHT_API_URL=http://10.8.0.1:4000
PEERSIGHT_HOST_ID=
PEERSIGHT_TOKEN=
BUILD_MODE=native
PEERSIGHT_LOOP_INTERVAL=30
PEERSIGHT_READ_ONLY=false
PEERSIGHT_REDACT_SECRETS=false
PEERSIGHT_WG_BINARY=wg
PEERSIGHT_CONFIG_DIR=/etc/wireguard
PEERSIGHT_CREDENTIALS_FILE=/etc/peersight/credentials.conf
PEERSIGHT_UNMANAGED_INTERFACES=

# Broker pipe 1: file output.
PEERSIGHT_PIPE_1_NAME=events-file
PEERSIGHT_PIPE_1_TO=file
PEERSIGHT_PIPE_1_FROM=alerts,changes
PEERSIGHT_PIPE_1_MAX=100
PEERSIGHT_PIPE_1_FILE=/var/log/peersight/events.jsonl

# Optional broker pipe 2: syslog output.
# PEERSIGHT_PIPE_2_NAME=siem-syslog
# PEERSIGHT_PIPE_2_TO=syslog
# PEERSIGHT_PIPE_2_FROM=alerts,changes
# PEERSIGHT_PIPE_2_MAX=50
# PEERSIGHT_PIPE_2_SYSLOG_ADDRESS=localhost:514
# PEERSIGHT_PIPE_2_SYSLOG_FACILITY=local0
# PEERSIGHT_PIPE_2_SYSLOG_PRIORITY=info
# PEERSIGHT_PIPE_2_SYSLOG_TAG=peersight
