# ==============================================================
# Benchmark environment
#
# Use on the machine running benchmark/run_all.sh.
#
# benchmark/config.sh auto-loads .env and .env.benchmark when present.
# You can still load it manually for ad-hoc shell commands:
#   cp .env.benchmark.example .env.benchmark
#   set -a && . ./.env.benchmark && set +a
# ==============================================================

# Topology
WG_SERVER_IP=10.8.0.1
WG_CLIENT_IP=10.8.0.2
WG_INTERFACE=wg0
WG_PORT=51820
CLOUD_PUBLIC_IP=
WWAN_INTERFACE=
QMI_DEVICE=

# Service endpoints over WireGuard
PROMETHEUS_URL=http://10.8.0.1:9090
LOKI_URL=http://10.8.0.1:3100
GRAFANA_URL=http://10.8.0.1:3000
NODE_EXPORTER_CLOUD=http://10.8.0.1:9100
NODE_EXPORTER_EDGE=http://127.0.0.1:9100
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOYMENT

# iperf3 / rsync targets
IPERF3_SERVER=10.8.0.1
IPERF3_PORT=5201
IPERF3_DURATION=10
IPERF3_PARALLEL=4
TCP_WINDOW_SIZE=512K
SUSTAINED_DURATION=60

SSH_USER=ec2-user
SSH_KEY=~/.ssh/id_rsa
REMOTE_TMP=/tmp/benchmark_rx
LOCAL_TMP=/tmp/benchmark_tx

# Benchmark framework
REPORT_DIR=./reports
HTTP_TIMEOUT=10
PING_COUNT=20
PING_INTERVAL=0.2

# Connectivity and signal thresholds
MAX_HANDSHAKE_AGE=180
MAX_RTT_MS=150
MAX_LOSS_PCT=5
MAX_JITTER_MS=30
MIN_RSRP=-110
MIN_RSRQ=-20

# Bandwidth thresholds
MIN_TCP_MBPS=5
MIN_UDP_MBPS=2
UDP_LOW_RATE_MIN_RATIO=0.90
MIN_RSYNC_MBPS=2
MIN_SUSTAINED_MBPS=3
MAX_VARIANCE_PCT=40

# Load and failover thresholds
CONCURRENCY=10
ITERATIONS=30
MAX_P95_MS=3000
MAX_RECONNECT_S=30
MAX_WG_RECOVERY_S=60
MAX_MONITORING_GAP_S=120
